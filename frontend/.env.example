# Copy to .env and fill in. Only VITE_* values reach the browser, so never put
# a Supabase service-role / secret key here.

# Supabase > Project settings > API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>

# Python services. These defaults suit local development; in production use the
# public addresses from backend/deploy/README.md (e.g. https://SITE/detector).
VITE_DETECTOR_URL=http://localhost:8000
VITE_LIVING_ROOM_LAYOUT_URL=http://localhost:8100
VITE_BEDROOM_LAYOUT_URL=http://localhost:8200
VITE_KITCHEN_LAYOUT_URL=http://localhost:8300
VITE_BATHROOM_LAYOUT_URL=http://localhost:8400
VITE_DINING_LAYOUT_URL=http://localhost:8500
VITE_MASTER_BEDROOM_LAYOUT_URL=http://localhost:8600
