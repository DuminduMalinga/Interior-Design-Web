# Merge into backend/deploy/Caddyfile: put the (security) snippet at the top,
# then add `import security` as the first line inside the site block.

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# 11 MB cap: a 10 MB floor plan plus the multipart envelope (the upload page and the
	# floorplans bucket allow 10 MB; also set MAX_IMAGE_BYTES=10485760 on the detector,
	# whose default is 12 MB). Larger bodies get 413.
	request_body {
		max_size 11MB
	}
}

# Usage:
# {$SITE_ADDRESS} {
#	import security
#	handle_path /detector/* { reverse_proxy detector:8000 }
#	...
# }
#
# Rate limiting needs a third-party module (build Caddy with xcaddy):
#   github.com/mholt/caddy-ratelimit
# Example inside the site block:
#   rate_limit {
#       zone detect { key {remote_host}  events 6   window 1m }
#       zone layout { key {remote_host}  events 30  window 1m }
#   }
# Without a custom Caddy build, use `slowapi` inside each FastAPI service instead.
#
# Note: the services now also require a signed-in user (backend/*/supabase_auth.py),
# so anonymous traffic is refused before it costs CPU. Rate limits still matter for
# signed-in abuse.
