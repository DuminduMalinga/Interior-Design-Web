# Copy to .env on the server and fill in.
# Public hostname Caddy serves (no http://). No domain? use <elastic-ip-with-dashes>.nip.io
SITE_ADDRESS=3-110-20-5.nip.io
# Your Vercel URL(s), comma separated, no trailing slash
ALLOWED_ORIGINS=https://your-app.vercel.app
# Every service only answers signed-in users. It asks Supabase whether the
# visitor's token is valid, so it needs the project URL and the PUBLIC anon key
# (the same two values the website uses). Never put the service-role key here.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
