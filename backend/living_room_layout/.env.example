# Copy to .env and adjust as needed. All values are optional.

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fallback millimetres-per-pixel, used ONLY when the room has no detected
# door to recover the real-world scale from (a standard 900mm door leaf).
DEFAULT_MM_PER_PX=20

# How far (in source-image pixels) a door/window box may sit from the room's
# bounding box and still count as belonging to that room.
OPENING_MARGIN_RATIO=0.10
OPENING_MARGIN_MIN=15
OPENING_MARGIN_MAX=90
