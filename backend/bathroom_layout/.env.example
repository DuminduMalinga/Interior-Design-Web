# Copy to .env and adjust as needed. All values are optional.

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fallback millimetres-per-pixel, used ONLY when the floor plan has no detected
# door to recover the real-world scale from (a standard 900mm door leaf).
DEFAULT_MM_PER_PX=20

# How far (in source-image pixels) a door/window box may sit from one of the
# room's wall lines and still count as lying on that wall.
OPENING_MARGIN_RATIO=0.08
OPENING_MARGIN_MIN=10
OPENING_MARGIN_MAX=60

# The service only answers signed-in users: it asks Supabase whether the
# visitor's token is valid. Use the same two PUBLIC values as the website
# (never the service-role key).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
# Local development only: skip the sign-in check. Leave this out in production.
REQUIRE_AUTH=false
# Show the interactive API docs at /docs (off by default).
# ENABLE_DOCS=true
