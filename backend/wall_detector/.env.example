# Copy to .env and adjust as needed. All values are optional.

# Path to the YOLO weights. Defaults to ./models/best.pt
# MODEL_PATH=C:/Users/HashTag/Desktop/WallDetectoor/best.pt

# Detection thresholds
DETECT_CONF=0.25
DETECT_IOU=0.45

# OCR (room-label reading with EasyOCR)
OCR_ENABLED=true
OCR_MIN_CONF=0.30

# Where per-floor-plan room JSON files are written (default ./output)
# OUTPUT_DIR=C:/some/other/path

# Max upload size in bytes (default 12 MB)
MAX_IMAGE_BYTES=12582912

# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
